---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const essays = await getCollection("essays");
  return essays.map((essay) => ({
    params: { slug: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);

const formattedDate = new Date(essay.data.date + "T00:00:00").toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});
---

<Base title={`${essay.data.title} | Photo Essays`}>
  <article class="essay">
    <header class="essay-header">
      <h1>{essay.data.title}</h1>
      <time>{formattedDate}</time>
      <p class="essay-author">by {essay.data.author}</p>
    </header>
    <div class="essay-content">
      <Content />
    </div>
    <footer class="essay-footer">
      <a href="/essays">&larr; All Essays</a>
    </footer>
  </article>
</Base>
